# ===========================================================================
# MassageVIP Riyadh — environment template
# Copy to `.env` and replace every placeholder. NEVER commit the real `.env`.
#   cp .env.example .env
# ===========================================================================

# --- App -------------------------------------------------------------------
APP_NAME="MassageVIP Riyadh Growth API"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api
PUBLIC_BASE_URL="http://127.0.0.1:8000"

# --- Database --------------------------------------------------------------
# Dev / test (default): local SQLite file, zero cost, works on Termux.
DATABASE_URL="sqlite:///./massagevip_dev.db"
# Production (Supabase Postgres). Use the *pooled* connection string.
# DATABASE_URL="postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Security --------------------------------------------------------------
# Generate new values:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_generate_with_secrets_token_urlsafe"
# Admin/interop API key for server-to-server calls (health, admin tasks).
ADMIN_API_KEY="CHANGE_ME_generate_with_secrets_token_urlsafe"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt work factor (12 is a good default; lower only for tests).
BCRYPT_ROUNDS=12
# Comma-separated list of allowed dashboard origins (CORS).
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# --- Rate limiting (in-process, no external infra) -------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# --- WhatsApp Business Platform (Phase 4) ----------------------------------
# Leave blank until Meta approves your WhatsApp Business Account (WABA).
WHATSAPP_VERIFY_TOKEN="CHANGE_ME_webhook_verify_token"
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_GRAPH_BASE="https://graph.facebook.com"
# When true the API only *drafts* replies (dry-run). Keep true until approved.
WHATSAPP_DRY_RUN=true

# --- Business rules --------------------------------------------------------
# Business default location/timezone used for location-compatibility scoring.
BUSINESS_CITY="Riyadh"
BUSINESS_TIMEZONE="Asia/Riyadh"
BUSINESS_COUNTRY_CODE="+966"
# Comma-separated service keywords treated as strong intent signals
# (English + Arabic — the business serves Riyadh).
HOT_SERVICE_KEYWORDS="massage,spa,home service,booking,appointment,مساج,سبا,حجز,موعد,خدمة منزلية"
